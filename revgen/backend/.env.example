# RevGen Backend Environment Variables
# Copy this file to .env and fill in the values

PORT=3000
DATABASE_URL=postgres://username:password@localhost:5433/database_name

# Razorpay Test Mode Credentials
# Sign up at https://dashboard.razorpay.com and use TEST MODE keys only.
# Test keys start with 'rzp_test_'. Do NOT use live keys.
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
